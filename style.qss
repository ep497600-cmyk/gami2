/* Poora App ka look */
QWidget {
    background: #121212;
    color: white;
    font-family: Arial;
}

/* Loading text ko stylish banao */
QLabel#loading_text {
    font-size: 30px;
    font-weight: bold;
    color: #00f2fe;
}

/* Login button ko glass look do */
QPushButton#login_button {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid white;
    border-radius: 20px;
    padding: 15px 30px;
    backdrop-filter: blur(10px);
}